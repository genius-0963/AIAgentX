# AIAgentX Environment Configuration
# Copy this file to .env and update values as needed

# Application
APP_NAME=AIAgentX
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/v1

# Security (required - generate a secure random string for production)
SECRET_KEY=your-secret-key-min-16-chars

# Database (required - async driver required)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://aiagentx:aiagentx@localhost:5432/aiagentx

# Synchronous URL for Alembic migrations
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL_SYNC=postgresql+psycopg://aiagentx:aiagentx@localhost:5432/aiagentx

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Observability - OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aiagentx-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_PROPAGATORS=tracecontext,baggage

# Observability - Structured Logging
LOG_FORMAT=json
LOG_REDACT_KEYS=password,secret,token,api_key,authorization,credit_card,ssn
# LOG_LEVEL_OVERRIDES={"module.name": "DEBUG"}

# Observability - Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
METRICS_BUCKETS=0.005,0.01,0.025,0.05,0.1,0.25,0.5,1.0,2.5,5.0,10.0

# Observability - Audit System
AUDIT_ENABLED=true
AUDIT_OUTBOX_TABLE=audit_outbox
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL_SECONDS=5
AUDIT_RETENTION_DAYS=2555
AUDIT_TAMPER_PROOF=true

# Backup & Recovery
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=
BACKUP_STORAGE_PATH=/backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=aiagentx/backups